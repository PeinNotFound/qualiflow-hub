@startuml DB-02 Documentation KPI Risques
!theme plain
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam classFontSize 10
skinparam packageFontSize 12
skinparam ClassBorderColor #2c3e50
skinparam ClassBackgroundColor #ecf0f1

title Qualibot-Hub — DB-02: Documentation, KPI & Risques

' ============================================================
package "Documentation - 5 Axes" #F4ECF7 {

  class Processus {
    _id : ObjectId
    --
    code : String
    name : String
    isPublished : Boolean
  }

  class DocumentationAxe {
    _id : ObjectId
    --
    processus_id : ObjectId <<FK Processus>>
    axe_number : Enum[1, 2, 3, 4, 5]
    axe_label : String
    content : Mixed
    updatedAt : Date
    updatedBy : ObjectId <<FK User>>
  }

  note right of DocumentationAxe
    Axe 1 : Fiche Identite et Gouvernance
    Axe 2 : Cartographie du Processus
    Axe 3 : Procedures et Instructions
    Axe 4 : KPIs
    Axe 5 : Enregistrements et Preuves
  end note

  class DocumentFile {
    _id : ObjectId
    --
    code : String <<auto-generated>>
    libelle : String
    type : Enum[procedure, manuel, instruction, formulaire, enregistrement, externe]
    version : String
    statut : Enum[enRedaction, enVerification, enVigueur, perime]
    fileUrl : String
    mimeType : String
    site_id : ObjectId <<FK Site>>
    activite : String
    motif_maj : String
    date_mise_en_vigueur : Date
    lastReviewedAt : Date
    reviewDueDate : Date <<+12 months>>
    isConfidentiel : Boolean
    axe_id : ObjectId <<FK DocumentationAxe>>
    superviseur_id : ObjectId <<FK User>>
    redacteurs : ObjectId[] <<FK User>>
    verificateurs : ObjectId[] <<FK User>>
    approbateurs : ObjectId[] <<FK User>>
    documents_renvoi : ObjectId[] <<FK DocumentFile>>
    modificationLogs : ModifLogEmbed[]
    createdAt : Date
  }

  class ModifLogEmbed <<embed>> {
    user_id : ObjectId <<FK User>>
    action : String
    motif : String
    timestamp : Date
  }

  class DocumentExterne {
    _id : ObjectId
    --
    reference : String
    libelle : String
    source : String
    fileUrl : String
    date_reception : Date
    processus_ids : ObjectId[] <<FK Processus>>
    axe_id : ObjectId <<FK DocumentationAxe>>
    createdAt : Date
  }

  class ListeDiffusion {
    _id : ObjectId
    --
    document_id : ObjectId <<FK DocumentFile>>
    destinataires : ObjectId[] <<FK Employee>>
    date_diffusion : Date
    mode : Enum[electronique, papier]
    accuses_reception : AccuseEmbed[]
  }

  class AccuseEmbed <<embed>> {
    employee_id : ObjectId <<FK Employee>>
    date_lecture : Date
    isConfirmed : Boolean
  }

}

' ============================================================
package "Indicateurs / KPI" #FDEBD0 {

  class Indicateur_Type {
    _id : ObjectId
    --
    designation : String
    processus_id : ObjectId <<FK Processus>>
    liste_acces : ObjectId[] <<FK Employee>>
  }

  class Axe_Politique {
    _id : ObjectId
    --
    code_axe : String
    libelle : String
  }

  class Indicateur {
    _id : ObjectId
    --
    libelle : String
    processus_id : ObjectId <<FK Processus>>
    type_id : ObjectId <<FK Indicateur_Type>>
    axe_id : ObjectId <<FK Axe_Politique>>
    periodicite : Enum[mensuel, trimestriel, semestriel, annuel]
    type_suivi : Enum[manuel, formule, import]
    type_resultat : Enum[moyenne, cumul, ponderee, dernier, ouiNon]
    formule : String
    unite : String
    responsable_id : ObjectId <<FK Employee>>
    isActive : Boolean
    createdAt : Date
  }

  class Indicateur_Valeur {
    _id : ObjectId
    --
    indicateur_id : ObjectId <<FK Indicateur>>
    date_periode : String <<YYYY-MM>>
    valeur_saisie : Number
    valeur_ponderee : Number
    commentaire : String
    saisi_par : ObjectId <<FK User>>
    createdAt : Date
  }

  class Historique_Cible {
    _id : ObjectId
    --
    indicateur_id : ObjectId <<FK Indicateur>>
    valeur_cible : Number
    seuil_nc : Number
    date_application : Date
  }

}

' ============================================================
package "Risques / AMDEC" #FDEDEC {

  class Risque_Domaine {
    _id : ObjectId
    --
    designation : String
    type : Enum[menace, opportunite]
    seuil_criticite_acceptable : Number
  }

  class Critere_Evaluation_Risque {
    _id : ObjectId
    --
    libelle : String
    domaine_id : ObjectId <<FK Risque_Domaine>>
    notes : Note_Critere_Embed[]
  }

  class Note_Critere_Embed <<embed>> {
    valeur_numerique : Number
    signification_texte : String
  }

  class Calcul_Methode {
    _id : ObjectId
    --
    libelle : String
    formule_texte : String
  }

  class Risque_Fiche {
    _id : ObjectId
    --
    processus_id : ObjectId <<FK Processus>>
    domaine_id : ObjectId <<FK Risque_Domaine>>
    methode_id : ObjectId <<FK Calcul_Methode>>
    date : Date
    objet_incertitude : String
    cause : String
    evenement : String
    enjeu : String
    statut : Enum[initial, residuel]
    score_brut : Number <<auto-computed>>
    score_residuel : Number <<auto-computed>>
    critere_notes : CritereNoteEmbed[]
    actions : ObjectId[] <<FK Action>>
    participants : ObjectId[] <<FK Employee>>
    createdAt : Date
    updatedAt : Date
  }

  class CritereNoteEmbed <<embed>> {
    critere_id : ObjectId <<FK Critere_Evaluation_Risque>>
    note_valeur : Number
  }

}

' RELATIONSHIPS
Processus "1" -- "5" DocumentationAxe : structure en
DocumentationAxe "1" -- "*" DocumentFile : contient
DocumentFile "1" -- "*" ModifLogEmbed : logs
DocumentFile "1" -- "*" ListeDiffusion : diffuse via
ListeDiffusion "1" -- "*" AccuseEmbed
DocumentExterne "*" -- "*" DocumentationAxe : classee dans

Processus "1" -- "*" Indicateur : mesure par
Indicateur "1" -- "*" Indicateur_Valeur : valeurs
Indicateur "1" -- "*" Historique_Cible : cibles
Indicateur "*" -- "1" Indicateur_Type
Indicateur "*" -- "1" Axe_Politique

Processus "1" -- "*" Risque_Fiche : expose a
Risque_Fiche "*" -- "1" Risque_Domaine
Risque_Fiche "*" -- "1" Calcul_Methode
Risque_Domaine "1" -- "*" Critere_Evaluation_Risque

@enduml
